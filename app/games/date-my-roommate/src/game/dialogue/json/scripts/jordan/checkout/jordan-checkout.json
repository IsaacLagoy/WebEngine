{
  "id": "jordan-checkout",
  "steps": [
    { "kind": "enter", "side": "left" },
    {
      "kind": "branch",
      "cases": [
        { "when": { "score": { "eq": 0 } }, "queue": "jordan-checkout-reaction-fail" },
        { "when": { "score": { "lt": 0.5 } }, "queue": "jordan-checkout-reaction-mid" }
      ],
      "default": "jordan-checkout-reaction-good"
    }
  ]
}
