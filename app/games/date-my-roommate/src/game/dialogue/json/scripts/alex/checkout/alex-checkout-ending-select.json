{
  "id": "alex-checkout-ending-select",
  "steps": [
    {
      "kind": "select",
      "options": [
        {
          "text": "Give gift",
          "queue": "alex-checkout-gift-form",
          "unavailableWhen": { "not": { "inventoryHasAnyGift": true } },
          "unavailableText": "No gifts in your inventory"
        },
        {
          "text": "Ask them on a date",
          "queue": "alex-checkout-date-accept",
          "unavailableWhen": { "hasScheduledEvent": true },
          "unavailableText": "You already made plans"
        },
        { "text": "Say goodbye", "queue": "alex-checkout-farewell" }
      ]
    }
  ]
}
